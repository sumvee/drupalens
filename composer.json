{
    "name": "sumvee/drupalens",
    "description": "A lens on your Drupal site's health: security, support status, and hygiene from the command line.",
    "type": "project",
    "license": "Apache-2.0",
    "keywords": ["drupal", "audit", "security", "cli", "static-analysis"],
    "authors": [
        {"name": "Sumit Vig"}
    ],
    "require": {
        "php": ">=8.1",
        "symfony/console": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {"Drupalens\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Drupalens\\Tests\\": "tests/"}
    },
    "bin": ["bin/drupalens"],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
